{
  "name": "@gameagent/desktop",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Noobi.ai desktop AI game-production workbench",
  "main": "dist/main/main.js",
  "scripts": {
    "clean:main": "node scripts/clean-main.mjs",
    "predev": "npm run clean:main && npm run build:icon",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on tcp:5174 file:dist/main/main.js file:dist/main/preload.cjs && cross-env GAMEAGENT_RENDERER_URL=http://127.0.0.1:5174 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run clean:main && npm run typecheck && vite build && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "bundle:runtime": "npm --prefix ../.. run bundle",
    "prepare:runtime-deps": "node scripts/prepare-runtime-deps.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "package:prepare": "npm run bundle:runtime && npm run build && npm run build:icon && npm run prepare:runtime-deps && npm run smoke:runtime",
    "package": "npm run package:mac",
    "package:app": "npm run package:prepare && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "package:mac": "npm run package:prepare && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never && npm run verify:mac-installer",
    "package:mac:signed": "npm run package:prepare && electron-builder --mac dmg --publish never -c.forceCodeSigning=true -c.mac.hardenedRuntime=true -c.mac.notarize=true && npm run verify:mac-installer",
    "verify:mac-installer": "node scripts/verify-macos-installer.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "extract-zip": "^2.0.1",
    "lucide-react": "^1.29.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.gameagent.desktop",
    "productName": "Noobi.ai",
    "electronVersion": "43.3.0",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".runtime-deps/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".runtime-deps/package.json",
        "to": "runtime/package.json"
      },
      {
        "from": ".runtime-deps/runtime-deps-manifest.json",
        "to": "runtime/runtime-deps-manifest.json"
      },
      {
        "from": "../../agent-test/templates",
        "to": "game-skill/templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../agent-test/docs",
        "to": "game-skill/docs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../agent-test/prompts/custom.md",
        "to": "game-skill/custom.md"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "Noobi.ai-${version}-${arch}.${ext}",
      "title": "Noobi.ai ${version}",
      "backgroundColor": "#151711",
      "iconSize": 112,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 210
        },
        {
          "x": 430,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
